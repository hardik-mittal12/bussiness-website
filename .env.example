# Modern Wholesale Footwear Platform - Environment Configuration

# Public Site URL (Used for Canonical URLs, Open Graph, Sitemap generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Connection (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Privileged Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Storage Buckets (Pre-configured via SQL migrations)
SUPABASE_STORAGE_BUCKET_PRODUCTS=product-images
SUPABASE_STORAGE_BUCKET_ASSETS=business-assets
